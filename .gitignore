# Rust
/target/
/apps/launcher/target/

# The launcher payload is generated by tools/build-release.ps1 and embedded
# into the launcher binary, so it is not stored in git.
/apps/launcher/payload/*
!/apps/launcher/payload/.gitignore

# Android
/android/.gradle/
/android/local.properties
/android/**/build/
/android/app/release/
/android/.idea/
*.iml

# Visual Studio / MSBuild leftovers
.vs/
**/x64/Release/
**/x64/Debug/
**/Win32/Release/
**/Win32/Debug/
**/Release/*.obj
**/Release/*.pdb
**/Debug/*.obj
**/Debug/*.pdb
*.user
*.suo

# Generated release output
/release/

# Test material and scratch files from the development machine
/tools/*.png
/tools/*.jpg
/tools/*.jpeg
/tools/*.log
/tools/*.raw
/tools/*.wav
/tools/*.zip
/tools/*.h264
/tools/dumpframes/
/tools/softcam-src/
/tools/ffmpeg/ffmpeg-*-essentials_build/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
